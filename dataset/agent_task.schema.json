{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niabench.dev/schemas/agent_task.schema.json",
  "title": "NiaBench Layer 2 Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_task_id",
    "library",
    "version_introduced",
    "category",
    "difficulty",
    "agent_goal",
    "workspace_seed",
    "expected_artifacts",
    "allowed_output_paths",
    "retrieval_hints"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 5
    },
    "source_task_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 5
    },
    "library": {
      "type": "string",
      "minLength": 2
    },
    "version_introduced": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "api-migration",
        "import-path",
        "config-schema",
        "type-signature",
        "best-practice"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "agent_goal": {
      "type": "string",
      "minLength": 20
    },
    "workspace_seed": {
      "$ref": "#/$defs/workspace_seed"
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact_spec"
      }
    },
    "allowed_output_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relative_file_path"
      }
    },
    "retrieval_hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_command": {
      "$ref": "#/$defs/test_command"
    },
    "success_notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "relative_file_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\*)(?!.*//)[A-Za-z0-9._@/-]+$"
    },
    "workspace_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_dir"
      ],
      "properties": {
        "seed_dir": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._@/-]+$",
          "minLength": 1
        }
      }
    },
    "artifact_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_file_path"
        },
        "kind": {
          "type": "string",
          "enum": [
            "code_file",
            "config_file",
            "text_file",
            "json_file"
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "max_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "test_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "default": "."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        }
      }
    }
  }
}
